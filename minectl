#!/bin/bash

# minectl — remote Minecraft server automation CLI
# ----- https://github.com/clxrityy/minectl ------
# Config directory specified in ~/.minectl/config (CONFIG_DIR)

set -euo pipefail

MINECTL_VERSION="0.4.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# shellcheck disable=SC1091
source "$LIB_DIR/config.sh"

usage() {
    cat <<'EOF'
minectl v0.3.0 — remote Minecraft server automation

Usage:
    minectl init <user@host>
    minectl import-server <user@host> --server-name NAME [--java-bin PATH]
    minectl create-server <user@host> --server-name NAME [--port PORT] [--memory MEMORY] [--jar JAR_URL] [--java-version VERSION]
    minectl start <user@host> --server-name NAME
    minectl stop <user@host> --server-name NAME
    minectl status <user@host> --server-name NAME
    minectl logs <user@host> --server-name NAME [--follow]
    minectl list <user@host>
    minectl validate <user@host> [--server-name NAME]
    minectl version

See docs/ for full documentation.

EOF
    exit 1
}

version() {
    echo "minectl v${MINECTL_VERSION}"
}

# SSH wrapper with dev-friendly options
# Usage: ssh_cmd "user@host" "command"
ssh_cmd() {
    local remote="$1"
    local cmd="$2"
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$remote" "$cmd"
}

# SCP wrapper
scp_cmd() {
    local src="$1"
    local dst="$2"
    scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -q "$src" "$dst"
}

# Trim quotes from a string in jvm.properties format
trim_quotes() {
    local value="$1"
    value="${value#\"}"
    value="${value%\"}"
    echo "$value"
}

# Read a property from a jvm.properties file on a remote host
read_jvm_property_remote() {
    local remote_user_host="$1"
    local file_path="$2"
    local key="$3"

    ssh_cmd "$remote_user_host" "
        awk -F= '
            /^[[:space:]]*#/ { next }
            \$1 ~ /^[[:space:]]*${key}[[:space:]]*$/ {
                sub(/^[[:space:]]+/, \"\", \$2)
                sub(/[[:space:]]+$/, \"\", \$2)
                print \$2
                exit
            }
        ' '$file_path'
    " 2>/dev/null || true
}

# Check if a remote file exists
remote_file_exists() {
    local remote_user_host="$1"
    local path="$2"
    ssh_cmd "$remote_user_host" "[[ -f '$path' ]]" >/dev/null 2>&1
}

# Check if a remote directory exists
remote_dir_exists() {
    local remote_user_host="$1"
    local path="$2"
    ssh_cmd "$remote_user_host" "[[ -d '$path' ]]" >/dev/null 2>&1
}

load_remote_config_into_array() {
    local remote_user_host="$1"
    local remote_path="$2"
    local -n result="$3"

    local config_text
    config_text=$(ssh_cmd "$remote_user_host" "cat '$remote_path' 2>/dev/null" || true)

    [[ -z "$config_text" ]] && return 1

    while IFS='=' read -r key value; do
        [[ "$key" =~ ^#.*$ ]] && continue
        [[ -z "$key" ]] && continue
        key="${key## }"; key="${key%% }"
        value="${value## }"; value="${value%% }"
        # shellcheck disable=SC2034
        result["$key"]="$value"
    done <<< "$config_text"

    return 0
}

# Resolve the Java executable on a remote host, either from provided path or by discovery
resolve_java_bin() {
    local remote_user_host="$1"
    local provided_java_bin="${2:-}"

    if [[ -n "$provided_java_bin" ]]; then
        if ssh_cmd "$remote_user_host" "[[ -x '$provided_java_bin' ]]" >/dev/null 2>&1; then
            echo "$provided_java_bin"
            return 0
        fi
        color_red "✗ Provided Java executable is not valid: $provided_java_bin"
        return 1
    fi

    local discovered
    discovered=$(ssh_cmd "$remote_user_host" "command -v java" 2>/dev/null || true)

    if [[ -n "$discovered" ]]; then
        echo "$discovered"
        return 0
    fi

    color_yellow "Java executable not found automatically on $remote_user_host."
    read -r -p "Enter remote Java executable path: " discovered

    if [[ -z "$discovered" ]]; then
        color_red "✗ Java executable path is required."
        return 1
    fi

    if ! ssh_cmd "$remote_user_host" "[[ -x '$discovered' ]]" >/dev/null 2>&1; then
        color_red "✗ Remote Java executable is not executable: $discovered"
        return 1
    fi

    echo "$discovered"
}

# Initialize config on remote host (interactive)
init() {
    local remote_user_host="$1"

    # Get client config
    local client_config="$HOME/.minectl/config"
    if [[ ! -f "$client_config" ]]; then
        color_red "✗ Client config not found: $client_config"
        color_yellow "Create it: cp config.template ~/.minectl/config && edit CONFIG_DIR"
        return 1
    fi

    # Load CONFIG_DIR from client config
    local config_dir
    config_dir=$(grep "^CONFIG_DIR=" "$client_config" | cut -d= -f2)
    if [[ -z "$config_dir" ]]; then
        color_red "✗ CONFIG_DIR not set in $client_config"
        return 1
    fi

    color_blue "Initializing on $remote_user_host..."
    color_blue "Config directory: $config_dir"
    echo ""  # Keep a blank line for readability

    # Create remote config directory
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$remote_user_host" "mkdir -p '$config_dir/servers' && chmod 755 '$config_dir'"

    # Create global config interactively
    color_yellow "Setting up base configuration..."

    # shellcheck disable=SC2155
    local mc_user=$(prompt_config_value "Minecraft user" "minecraft")
    # shellcheck disable=SC2155
    local mc_base_dir=$(prompt_config_value "Minecraft base directory" "/opt/minecraft")

    # Create global config
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$remote_user_host" "cat > '$config_dir/config' <<EOFCONF
# minectl global configuration
# Generated: $(date)

MC_USER=$mc_user
MC_BASE_DIR=$mc_base_dir

EOFCONF
"

    color_green "✓ Global config created."
    echo ""
    color_blue "Next:"
    echo "  minectl create-server $remote_user_host --server-name survival"
}

# Create a new server
create_server() {
    local remote_user_host="$1"
    local server_name="$2"
    local port="${PORT:-25565}"
    local memory="${MEMORY:-2G}"
    local jar_url="${JAR_URL:-}"

    # Get config_dir from client config
    local config_dir
    config_dir=$(get_config_dir) || { color_red "✗ CONFIG_DIR error"; exit 1; }

    [[ -z "$server_name" ]] && { color_red "✗ --server-name required"; exit 1; }

    color_blue "Creating server: $server_name"

    # Load global config from remote
    declare -A global_config=()
    if ! load_remote_config_into_array "$remote_user_host" "$config_dir/config" global_config; then
        color_red "✗ Global config not found. Run: minectl init $remote_user_host"
        exit 1
    fi

    if [[ -z "${global_config[MC_USER]:-}" || -z "${global_config[MC_BASE_DIR]:-}" ]]; then
        color_red "✗ Global config not found or incomplete. Run: minectl init $remote_user_host"
        exit 1
    fi

    local java_version="${JAVA_VERSION:-17}"
    local mc_user="${global_config[MC_USER]}"
    local mc_base_dir="${global_config[MC_BASE_DIR]}"

    # Default JAR if not provided
    if [[ -z "$jar_url" ]]; then
        jar_url="https://launcher.mojang.com/v1/objects/8dd1a28015f51b1803213892b50b7b4116555cfa/server.jar"
    fi

    # Create server config on remote
    local server_config="$config_dir/servers/$server_name.conf"
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$remote_user_host" "cat > '$server_config' <<EOFCONF
# minectl server: $server_name
ENABLED=true
PORT=$port
MEMORY=$memory
JAR_URL=$jar_url
EOFCONF
"

    color_green "✓ Server config created."

    # Deploy server (bootstrap)
    color_blue "Deploying server..."
    scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -q "$SCRIPT_DIR/bootstrap/bootstrap.sh" "$remote_user_host:/tmp/minectl-bootstrap.sh"

    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$remote_user_host" "bash /tmp/minectl-bootstrap.sh \
        --server-name '$server_name' \
        --port '$port' \
        --memory '$memory' \
        --jar '$jar_url' \
        --java-version '$java_version' \
        --mc-user '$mc_user' \
        --mc-base-dir '$mc_base_dir'"

    color_green "✓ Server deployed."
    color_blue "Next:"
    color_blue "  minectl start $remote_user_host --server-name $server_name"
}

# Import existing server
import_server() {
    local remote_user_host="$1"
    local server_name="$2"
    local provided_java_bin="${3:-}"

    [[ -z "$server_name" ]] && { color_red "✗ --server-name required"; exit 1; }

    local config_dir
    config_dir=$(get_config_dir) || { color_red "✗ CONFIG_DIR error"; exit 1; }

    declare -A global_config=()
    if ! load_remote_config_into_array "$remote_user_host" "$config_dir/config" global_config; then
        color_red "✗ Global config not found. Run: minectl init $remote_user_host"
        exit 1
    fi

    if [[ -z "${global_config[MC_USER]:-}" || -z "${global_config[MC_BASE_DIR]:-}" ]]; then
        color_red "✗ Global config not found or incomplete. Run: minectl init $remote_user_host"
        exit 1
    fi

    local mc_base_dir="${global_config[MC_BASE_DIR]}"
    local mc_user="${global_config[MC_USER]}"
    local server_dir="$mc_base_dir/$server_name"
    local jvm_props="$server_dir/jvm.properties"
    local server_config="$config_dir/servers/$server_name.conf"

    remote_dir_exists "$remote_user_host" "$server_dir" || {
        color_red "✗ Existing server directory not found: $server_dir"
        exit 1
    }

    remote_file_exists "$remote_user_host" "$jvm_props" || {
        color_red "✗ jvm.properties not found: $jvm_props"
        exit 1
    }

    if ssh_cmd "$remote_user_host" "[[ -f '$server_config' ]]" >/dev/null 2>&1; then
        color_red "✗ Server config already exists: $server_config"
        exit 1
    fi

    local java_bin
    java_bin=$(resolve_java_bin "$remote_user_host" "$provided_java_bin") || exit 1

    ssh_cmd "$remote_user_host" "cat > '$server_config' <<EOFCONF
# minectl imported server: $server_name
ENABLED=true
IMPORTED=true
JAVA_BIN=$java_bin
EOFCONF
"

    color_blue "Importing existing server service..."
    scp_cmd "$SCRIPT_DIR/bootstrap/bootstrap.sh" "$remote_user_host:/tmp/minectl-bootstrap.sh"

    ssh_cmd "$remote_user_host" "bash /tmp/minectl-bootstrap.sh \
        --import-existing true \
        --server-name '$server_name' \
        --mc-user '$mc_user' \
        --mc-base-dir '$mc_base_dir' \
        --java-bin '$java_bin'"

    color_green "✓ Existing server imported."
}

start() {
    local remote_user_host="$1"
    local server_name="$2"

    [[ -z "$server_name" ]] && { color_red "✗ --server-name required"; exit 1; }

    local service_name="minecraft-${server_name}"
    color_blue "Starting $server_name..."

    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$remote_user_host" "sudo systemctl start '$service_name'"
    color_green "✓ Started."
}

stop() {
    local remote_user_host="$1"
    local server_name="$2"

    [[ -z "$server_name" ]] && { color_red "✗ --server-name required"; exit 1; }

    local service_name="minecraft-${server_name}"
    color_blue "Stopping $server_name..."

    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$remote_user_host" "sudo systemctl stop '$service_name'"
    color_green "✓ Stopped."
}

status() {
    local remote_user_host="$1"
    local server_name="$2"

    [[ -z "$server_name" ]] && { color_red "✗ --server-name required"; exit 1; }

    local service_name="minecraft-${server_name}"
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$remote_user_host" "sudo systemctl status '$service_name'"
}

logs() {
    local remote_user_host="$1"
    local server_name="$2"
    local follow_flag=""

    [[ -z "$server_name" ]] && { color_red "✗ --server-name required"; exit 1; }
    [[ "${FOLLOW:-0}" == "1" ]] && follow_flag="1"

    local config_dir
    config_dir=$(get_config_dir) || { color_red "✗ CONFIG_DIR error"; exit 1; }

    declare -A global_config=()
    if ! load_remote_config_into_array "$remote_user_host" "$config_dir/config" global_config; then
        color_red "✗ Global config not found. Run: minectl init $remote_user_host"
        exit 1
    fi

    local mc_base_dir="${global_config[MC_BASE_DIR]:-}"
    [[ -z "$mc_base_dir" ]] && { color_red "✗ MC_BASE_DIR missing from global config"; exit 1; }

    local latest_log="$mc_base_dir/$server_name/logs/latest.log"
    local service_name="minecraft-${server_name}"

    if ssh_cmd "$remote_user_host" "[[ -r '$latest_log' ]]" >/dev/null 2>&1; then
        color_blue "Reading file logs: $latest_log"
        if [[ "$follow_flag" == "1" ]]; then
            ssh_cmd "$remote_user_host" "tail -n 50 -F '$latest_log'"
        else
            ssh_cmd "$remote_user_host" "tail -n 50 '$latest_log'"
        fi
        return
    fi

    color_yellow "File log not available, falling back to journalctl."
    if [[ "$follow_flag" == "1" ]]; then
        ssh_cmd "$remote_user_host" "sudo journalctl -u '$service_name' -n 50 -f"
    else
        ssh_cmd "$remote_user_host" "sudo journalctl -u '$service_name' -n 50"
    fi
}

list_servers() {
    local remote_user_host="$1"

    local config_dir
    config_dir=$(get_config_dir) || { color_red "✗ CONFIG_DIR error"; exit 1; }

    color_blue "Servers on $remote_user_host:"
    ssh_cmd "$remote_user_host" "
        shopt -s nullglob
        for conf in '$config_dir/servers'/*.conf; do
            [[ -f \$conf ]] || continue

            name=\$(basename \"\$conf\" .conf)
            enabled=\$(grep '^ENABLED=' \"\$conf\" | cut -d= -f2 || true)
            imported=\$(grep '^IMPORTED=' \"\$conf\" | cut -d= -f2 || true)
            port=\$(grep '^PORT=' \"\$conf\" | cut -d= -f2 || true)

            [[ -z \"\$enabled\" ]] && enabled='?'

            if [[ \"\$imported\" == 'true' ]]; then
                if [[ \"\$enabled\" == 'true' ]]; then
                    echo \"  ✓ \$name (imported)\"
                else
                    echo \"  ✗ \$name (imported, disabled)\"
                fi
            else
                [[ -z \"\$port\" ]] && port='?'
                if [[ \"\$enabled\" == 'true' ]]; then
                    echo \"  ✓ \$name (port \$port)\"
                else
                    echo \"  ✗ \$name (port \$port, disabled)\"
                fi
            fi
        done
    "
}

validate_remote_config() {
    local remote_user_host="$1"
    local server_name="${2:-}"

    local config_dir
    config_dir=$(get_config_dir) || { color_red "✗ CONFIG_DIR error"; exit 1; }

    if [[ -n "$server_name" ]]; then
        color_blue "Validating server config: $server_name"

        local remote_server_config="$config_dir/servers/$server_name.conf"
        declare -A server_config=()

        if ! load_remote_config_into_array "$remote_user_host" "$remote_server_config" server_config; then
            color_red "✗ Server config not found: $remote_server_config"
            exit 1
        fi

        if validate_server_config server_config; then
            color_green "✓ Server config valid."
        else
            exit 1
        fi
    else
        color_blue "Validating global config..."

        local remote_global_config="$config_dir/config"
        declare -A global_config=()

        if ! load_remote_config_into_array "$remote_user_host" "$remote_global_config" global_config; then
            color_red "✗ Global config not found: $remote_global_config"
            exit 1
        fi

        if validate_global_config global_config; then
            color_green "✓ Global config valid."
        else
            exit 1
        fi
    fi
}

# Parse arguments
[[ $# -eq 0 ]] && usage

COMMAND="$1"
shift

case "$COMMAND" in
    init)
        [[ $# -lt 1 ]] && usage
        init "$1"
        ;;
    create-server)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        JAVA_VERSION=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                --port) PORT="$2"; shift 2 ;;
                --memory) MEMORY="$2"; shift 2 ;;
                --jar) JAR_URL="$2"; shift 2 ;;
                --java-version) JAVA_VERSION="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        create_server "$REMOTE" "$SERVER_NAME"
        ;;
    import-server)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        JAVA_BIN=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                --java-bin) JAVA_BIN="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        import_server "$REMOTE" "$SERVER_NAME" "$JAVA_BIN"
        ;;
    start)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        start "$REMOTE" "$SERVER_NAME"
        ;;
    stop)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        stop "$REMOTE" "$SERVER_NAME"
        ;;
    status)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        status "$REMOTE" "$SERVER_NAME"
        ;;
    logs)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                --follow) FOLLOW=1; shift ;;
                *) shift ;;
            esac
        done
        logs "$REMOTE" "$SERVER_NAME"
        ;;
    list)
        [[ $# -lt 1 ]] && usage
        list_servers "$1"
        ;;
    validate)
        [[ $# -lt 1 ]] && usage
        REMOTE="$1"
        shift
        SERVER_NAME=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --server-name) SERVER_NAME="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        validate_remote_config "$REMOTE" "$SERVER_NAME"
        ;;
    version)
        version
        ;;
    *)
        usage
        ;;
esac
